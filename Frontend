// FILE: src/utils/storage.js
// Lightweight abstraction to simulate blockchain + IPFS storage using localStorage
const KEY = 'edutrust_demo_certificates'

export function readAll(){
  const raw = localStorage.getItem(KEY)
  return raw ? JSON.parse(raw) : []
}

export function save(cert){
  const arr = readAll()
  arr.push(cert)
  localStorage.setItem(KEY, JSON.stringify(arr))
}

export function update(hash, patch){
  const arr = readAll().map(c => c.hash === hash ? {...c, ...patch} : c)
  localStorage.setItem(KEY, JSON.stringify(arr))
}

export function findByHash(hash){
  return readAll().find(c => c.hash === hash)
}


